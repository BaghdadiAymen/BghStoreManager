{
  "name": "bipos-pro",
  "productName": "BiPOS PRO",
  "description": "BiPOS PRO Point of Sale Terminal",
  "author": "Boukhari Zone",
  "private": true,
  "version": "1.0.0",
  "main": "electron.js",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-app server.js",
    "lint": "tsc --noEmit",
    "app:dist": "vite build && electron-builder",
    "app:linux": "vite build && electron-builder --linux AppImage",
    "app:win": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.bipos.pro",
    "productName": "BiPOS PRO",
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron.js",
      "package.json"
    ],
    "directories": {
      "output": "dist-app"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    }
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
